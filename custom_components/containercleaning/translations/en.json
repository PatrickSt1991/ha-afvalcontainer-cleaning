          "exclude_pickup_today": "Exclude today's cleaning",
          "date_isoformat": "Use ISO date format",
          "exclude_list": "Container type exclude list"
        }
      },
      "manual": {
        "title": "Manual date file",
        "description": "File path or URL: A JSON file (.json) or iCalendar file (.ics) in your Home Assistant config directory, or an http(s) URL to an iCal feed. Relative paths are resolved from the config directory. When a JSON path does not exist yet, an example file is created for you to edit.\n\nJSON example: {\"cleanings\": [{\"type\": \"gft\", \"date\": \"2026-10-15\"}]}\n\nExclude today's cleaning: When enabled, sensors ignore cleaning scheduled for today and show the next cleaning after today.\nUse ISO date format: Show timestamps in ISO format where applicable.\nContainer type exclude list: Comma-separated container types to ignore (for example: gft,pmd).",
        "data": {
          "file_path": "File path or URL",
